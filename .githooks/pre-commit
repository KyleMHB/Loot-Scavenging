#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
# The copy lint lives in the Templates repo; set `git config templates.root <path>` if it is not at E:/Coding/Templates.
set -u
templates=$(git config --get templates.root || echo "E:/Coding/Templates")
python=$(command -v python || command -v python3)
lint="$templates/tools/copy-lint/copy_lint.py"
if [ -f "$lint" ]; then
    "$python" "$lint" --staged || exit 1
else
    echo "copy lint skipped: $lint not found"
fi

# Unit tests of Source/Model, when the commit touches code or XML (they run on the working tree, not only the staged files).
if git diff --cached --name-only | grep -qE '\.(cs|csproj|xml)$'; then
    dotnet test --nologo -v q || { echo "pre-commit: dotnet test failed"; exit 1; }
fi

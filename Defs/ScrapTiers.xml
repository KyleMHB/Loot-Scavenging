<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The tier table (spec, "Recycling"). Each tier names its scrap, the benches that recycle it, the silver value of one
       unit and the loot pool each unit picks from. A bench named for a tier also recycles every tier below it, with no
       check on the colony's era.
       Each unit of scrap picks ONE material from the pool by weight and returns valuePerUnit worth of it: valuePerUnit
       over the material's market value, rounded up or down at random so the average is exact. A material worth more than
       valuePerUnit comes as a single item with the matching chance. Because every pick is worth the same, a weight is that
       material's share of the tier's VALUE, not of the item count. The pool is static: it never reacts to research or stock.
       A tier's pool also holds the materials of the tiers below it, about 15% of the weight in total.
       A pool entry for a DLC material carries MayRequire (<li MayRequire="ludeon.rimworld.royalty"><thing>...</thing>
       <weight>5</weight></li>); the game skips it when the DLC is off.
       A pack changes benches, value or pool with a patch, e.g.
         <Operation Class="PatchOperationAdd">
           <xpath>/Defs/LootScavenging.ScrapTierDef[defName="LS_ScrapTier_Spacer"]/pool</xpath>
           <value><li><thing>MyAlloy</thing><weight>10</weight></li></value>
         </Operation>
       batchSize (default 5) is the most units a bill iteration uses; a bill takes a whole stack of any size, so a single
       unit is recycled too. workPerUnit is the work for each unit used. Starting values, to be tuned.
       studiedScrap is what study leaves in "study first, then recycle" mode (ticket 05); it recycles at the same benches
       from the same pool, at studiedYieldFactor (default 0.5) of valuePerUnit. -->

  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Neolithic</defName>
    <tier>Neolithic</tier>
    <scrap>LS_Scrap_Neolithic</scrap>
    <studiedScrap>LS_StudiedScrap_Neolithic</studiedScrap>
    <benches>
      <li>CraftingSpot</li>
    </benches>
    <valuePerUnit>3</valuePerUnit>
    <pool>
      <li><thing>WoodLog</thing><weight>40</weight></li>
      <li><thing>Leather_Plain</thing><weight>30</weight></li>
      <li><thing>Cloth</thing><weight>30</weight></li>
    </pool>
    <workPerUnit>40</workPerUnit>
  </LootScavenging.ScrapTierDef>

  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Medieval</defName>
    <tier>Medieval</tier>
    <scrap>LS_Scrap_Medieval</scrap>
    <studiedScrap>LS_StudiedScrap_Medieval</studiedScrap>
    <benches>
      <li>FueledSmithy</li>
      <li>ElectricSmithy</li>
    </benches>
    <valuePerUnit>4.5</valuePerUnit>
    <pool>
      <li><thing>Steel</thing><weight>60</weight></li>
      <li><thing>Silver</thing><weight>25</weight></li>
      <!-- neolithic materials, 15% -->
      <li><thing>WoodLog</thing><weight>6</weight></li>
      <li><thing>Cloth</thing><weight>6</weight></li>
      <li><thing>Leather_Plain</thing><weight>3</weight></li>
    </pool>
    <workPerUnit>50</workPerUnit>
  </LootScavenging.ScrapTierDef>

  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Industrial</defName>
    <tier>Industrial</tier>
    <scrap>LS_Scrap_Industrial</scrap>
    <studiedScrap>LS_StudiedScrap_Industrial</studiedScrap>
    <benches>
      <li>TableMachining</li>
    </benches>
    <valuePerUnit>5.5</valuePerUnit>
    <pool>
      <li><thing>Steel</thing><weight>40</weight></li>
      <li><thing>ComponentIndustrial</thing><weight>25</weight></li>
      <li><thing>Chemfuel</thing><weight>10</weight></li>
      <li><thing>Silver</thing><weight>10</weight></li>
      <!-- neolithic and medieval materials, 15% -->
      <li><thing>Cloth</thing><weight>6</weight></li>
      <li><thing>WoodLog</thing><weight>4</weight></li>
      <li><thing>Leather_Plain</thing><weight>5</weight></li>
    </pool>
    <workPerUnit>60</workPerUnit>
  </LootScavenging.ScrapTierDef>

  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Spacer</defName>
    <tier>Spacer</tier>
    <scrap>LS_Scrap_Spacer</scrap>
    <studiedScrap>LS_StudiedScrap_Spacer</studiedScrap>
    <benches>
      <li>FabricationBench</li>
    </benches>
    <valuePerUnit>16.5</valuePerUnit>
    <pool>
      <li><thing>Plasteel</thing><weight>40</weight></li>
      <li><thing>Gold</thing><weight>15</weight></li>
      <li><thing>Uranium</thing><weight>10</weight></li>
      <li><thing>ComponentSpacer</thing><weight>20</weight></li>
      <!-- steel and industrial components, 15% -->
      <li><thing>Steel</thing><weight>9</weight></li>
      <li><thing>ComponentIndustrial</thing><weight>6</weight></li>
    </pool>
    <workPerUnit>75</workPerUnit>
  </LootScavenging.ScrapTierDef>

  <!-- Vanilla has no ultratech or archotech bench, so both use the fabrication bench until a pack names its own. -->
  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Ultra</defName>
    <tier>Ultra</tier>
    <scrap>LS_Scrap_Ultra</scrap>
    <studiedScrap>LS_StudiedScrap_Ultra</studiedScrap>
    <benches>
      <li>FabricationBench</li>
    </benches>
    <valuePerUnit>24</valuePerUnit>
    <pool>
      <li><thing>Plasteel</thing><weight>35</weight></li>
      <li><thing>Uranium</thing><weight>15</weight></li>
      <li><thing>Gold</thing><weight>15</weight></li>
      <li><thing>ComponentSpacer</thing><weight>20</weight></li>
      <!-- spacer materials, 15% -->
      <li><thing>Steel</thing><weight>6</weight></li>
      <li><thing>ComponentIndustrial</thing><weight>9</weight></li>
    </pool>
    <workPerUnit>90</workPerUnit>
  </LootScavenging.ScrapTierDef>

  <LootScavenging.ScrapTierDef>
    <defName>LS_ScrapTier_Archotech</defName>
    <tier>Archotech</tier>
    <scrap>LS_Scrap_Archotech</scrap>
    <studiedScrap>LS_StudiedScrap_Archotech</studiedScrap>

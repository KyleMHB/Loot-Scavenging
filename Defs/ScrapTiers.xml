      <li>FabricationBench</li>
    </benches>
    <valuePerUnit>32.5</valuePerUnit>
    <pool>
      <li><thing>Plasteel</thing><weight>35</weight></li>
      <li><thing>Gold</thing><weight>25</weight></li>
      <li><thing>ComponentSpacer</thing><weight>25</weight></li>
      <!-- spacer materials, 15% -->
      <li><thing>Uranium</thing><weight>8</weight></li>
      <li><thing>Steel</thing><weight>7</weight></li>
    </pool>
    <workPerUnit>110</workPerUnit>
  </LootScavenging.ScrapTierDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Study (spec, "Study"): bills at a research bench use up scrap for research points. The study recipes and the list of
       research benches below are filled in at startup (LootScavenging.StudyRecipes), so modded benches that use the
       vanilla research bench class are included. Above vanilla research (priorityInType 100, sorted descending), so a
       researcher works study bills first. -->

  <WorkGiverDef>
    <defName>LS_DoBillsStudy</defName>
    <label>study scrap at research benches</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Research</workType>
    <verb>study</verb>
    <gerund>studying at</gerund>
    <priorityInType>110</priorityInType>
    <fixedBillGiverDefs>
      <li>SimpleResearchBench</li>
      <li>HiTechResearchBench</li>
    </fixedBillGiverDefs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

  <!-- What study leaves in "study first, then recycle" mode. It recycles at its tier's benches at a reduced yield
       (studiedYieldFactor in Defs/ScrapTiers.xml) and is never studied again: it has no study points. -->

  <ThingDef ParentName="LS_ScrapBase">
    <defName>LS_StudiedScrap_Neolithic</defName>
    <label>studied neolithic scrap</label>
    <description>Neolithic scrap that has already been studied. It can only be recycled, for less than unstudied scrap.</description>
    <graphicData>
      <texPath>Things/Item/LootScavenging/Scrap/Neolithic</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.62, 0.62, 0.62)</color>
    </graphicData>
  </ThingDef>


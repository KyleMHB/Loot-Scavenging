<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The default settings (spec, "The Progression pack"): the Progression preset, which a fresh config starts with and
       Reset returns to. Cleanup and Vanilla are built from it and set the rows the presets table names, so a patched
       default carries into them. A pack changes a default with a patch on the matching node, e.g.
         <Operation Class="PatchOperationReplace">
           <xpath>/Defs/LootScavenging.SettingsDefaultsDef[defName="LS_SettingsDefaults"]/values/rules/whoHostile</xpath>
           <value><whoHostile>Mark</whoHostile></value>
         </Operation>
       and locks a setting by adding its name to the locked list:
         <Operation Class="PatchOperationAdd">
           <xpath>/Defs/LootScavenging.SettingsDefaultsDef[defName="LS_SettingsDefaults"]/locked</xpath>
           <value><li>rules.whoHostile</li></value>
         </Operation>
       A locked setting always holds the value written here: the page shows it disabled with a reason, and presets, Reset
       and a saved value cannot change it. Lockable names: rules.whoHostile, rules.whoNonHostile, rules.whoWild,
       rules.whoPrisoners, rules.whoRecruitedPrisoners, rules.whoOtherJoiners, rules.homeMapOnly, rules.weapons,
       rules.apparel, rules.ammunition, rules.drugs, rules.medicine, rules.food, rules.other, rules.disassemblyYield,
       rules.disassemblyEfficiency, corpses.humanlike, corpses.animal, corpses.mechanoid, colonistsKeepGear,
       hostilesKeepGear, nonHostilesKeepGear, cremationStripsCorpses, unfamiliarScope, recycleOrStudy, studyTechprintProjects,
       studyPointsNeolithic, studyPointsMedieval, studyPointsIndustrial, studyPointsSpacer, studyPointsUltra,
       studyPointsArchotech, scrapMarketValueNeolithic, scrapMarketValueMedieval, scrapMarketValueIndustrial,
       scrapMarketValueSpacer, scrapMarketValueUltra, scrapMarketValueArchotech.
       A lock on a name from before 0.6.0 locks each setting that replaced it (rules.dropMode locks every Who row and item
       rule); a cut setting's name is accepted and ignored.
       The keep and remove lists and the protection toggles can be defaulted here but not locked.
       The defaults seed a config that has none saved. A saved config, or a partial one another tool wrote, keeps its
       values; a key it lacks takes the value written here, and locked settings are put back.
       Extras/Loot-Scavenging-AutoConfig/ holds an example Auto Mod Config preset. Its settings file lists every saved key
       and its values.
       packs/progression/ holds the Progression pack's preset as a patch. -->

  <LootScavenging.SettingsDefaultsDef>
    <defName>LS_SettingsDefaults</defName>
    <values>
      <rules>
        <whoHostile>Apply</whoHostile>
        <whoNonHostile>Apply</whoNonHostile>
        <whoWild>Apply</whoWild>
        <whoPrisoners>Apply</whoPrisoners>
        <whoRecruitedPrisoners>Apply</whoRecruitedPrisoners>
        <whoOtherJoiners>Mark</whoOtherJoiners>
        <homeMapOnly>false</homeMapOnly>
      <weapons>
        <outcome>Scrap</outcome>
        <onlyBeyondReach>true</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </weapons>
      <apparel>
        <outcome>Scrap</outcome>
        <onlyBeyondReach>true</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </apparel>
      <ammunition>
        <outcome>Keep</outcome>
        <onlyBeyondReach>false</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </ammunition>
      <drugs>
        <outcome>Keep</outcome>
        <onlyBeyondReach>false</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </drugs>
      <medicine>
        <outcome>Keep</outcome>
        <onlyBeyondReach>false</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </medicine>
      <food>
        <outcome>Keep</outcome>
        <onlyBeyondReach>false</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </food>
      <other>
        <outcome>Keep</outcome>
        <onlyBeyondReach>false</onlyBeyondReach>
        <limitQuality>false</limitQuality>
        <belowQuality>Normal</belowQuality>
        <limitHitPoints>false</limitHitPoints>
        <belowHitPointFraction>0.5</belowHitPointFraction>
        <chance>1</chance>
      </other>
        <disassemblyYield>EraTypical</disassemblyYield>
        <disassemblyEfficiency>0.5</disassemblyEfficiency>
        <protectQuestItems>true</protectQuestItems>
        <protectUniqueWeapons>true</protectUniqueWeapons>
        <protectPersonaWeapons>true</protectPersonaWeapons>
        <protectRelics>true</protectRelics>
        <keepList />
        <removeList />
        <!-- Replaced in 0.6.0 (ticket 25), kept at their 0.5.2 defaults so an old pack's patch on them still applies. A value
             a patch changes is translated into the settings above once the Def loads; a value left here does nothing. -->
        <hostile>true</hostile>
        <nonHostileFaction>true</nonHostileFaction>
        <noFaction>true</noFaction>
        <prisoners>true</prisoners>
        <prisonerJoinGear>FollowDropMode</prisonerJoinGear>
        <otherJoinGear>MarkUnfamiliar</otherJoinGear>
        <dropMode>ScrapOutOfReach</dropMode>
        <dropIncludesMedicine>false</dropIncludesMedicine>
        <dropIncludesAmmunition>false</dropIncludesAmmunition>
        <onDownedAndStrip>true</onDownedAndStrip>
        <degradeMin>0.1</degradeMin>
        <degradeMax>0.4</degradeMax>
        <degradeLowersQuality>false</degradeLowersQuality>
        <ejectCharges>true</ejectCharges>
      </rules>
      <corpses>
        <humanlike>false</humanlike>
        <animal>false</animal>
        <mechanoid>false</mechanoid>
        <!-- Cut in 0.6.0 (ticket 25); kept so an old patch on them still finds its node. -->
        <chance>1</chance>
        <butcherRemovesApparel>false</butcherRemovesApparel>
      </corpses>
      <colonistsKeepGear>true</colonistsKeepGear>
      <hostilesKeepGear>true</hostilesKeepGear>
      <nonHostilesKeepGear>true</nonHostilesKeepGear>
      <cremationStripsCorpses>false</cremationStripsCorpses>
      <unfamiliarScope>AllOutOfReach</unfamiliarScope>
      <recycleOrStudy>OneOrTheOther</recycleOrStudy>
      <studyTechprintProjects>false</studyTechprintProjects>
      <studyPointsNeolithic>5</studyPointsNeolithic>
      <studyPointsMedieval>7.5</studyPointsMedieval>
      <studyPointsIndustrial>7.5</studyPointsIndustrial>
      <studyPointsSpacer>12.5</studyPointsSpacer>
      <studyPointsUltra>17.5</studyPointsUltra>
      <studyPointsArchotech>25</studyPointsArchotech>
      <scrapMarketValueNeolithic>0.01</scrapMarketValueNeolithic>
      <scrapMarketValueMedieval>0.01</scrapMarketValueMedieval>
      <scrapMarketValueIndustrial>0.01</scrapMarketValueIndustrial>
      <scrapMarketValueSpacer>0.01</scrapMarketValueSpacer>
      <scrapMarketValueUltra>0.01</scrapMarketValueUltra>
      <scrapMarketValueArchotech>0.01</scrapMarketValueArchotech>
      <!-- Replaced in 0.6.0 (ticket 25), kept at their 0.5.2 defaults for old patches. -->
      <eraFallback>CarrierFaction</eraFallback>
      <scrapMarketValue>0.01</scrapMarketValue>
      <deathDrop>Ground</deathDrop>
      <studyEras>ColonyEraAndBelow</studyEras>
      <studyPointsMultiplier>1</studyPointsMultiplier>
    </values>
    <locked />
  </LootScavenging.SettingsDefaultsDef>

</Defs>
